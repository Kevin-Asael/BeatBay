@model BeatBay.DTOs.UserPlanStatusDto
@{
    ViewData["Title"] = "Gestionar Conexiones";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-users me-2"></i> Gestionar Conexiones
    </h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Plans")">Mis Planes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gestionar Conexiones</li>
        </ol>
    </nav>

    @* Estado del plan *@
    @if (Model.CurrentSubscription != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <i class="fas fa-info-circle me-2"></i> Estado de tu Plan
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <h5 class="mb-0">@Model.CurrentSubscription.PlanName</h5>
                        <p class="text-muted mb-0">Plan actual</p>
                    </div>
                    <div class="col-md-3 text-center">
                        <h4 class="mb-0">
                            <span class="badge bg-info fs-6">
                                @Model.CurrentSubscription.UsedConnections/@Model.CurrentSubscription.MaxConnections
                            </span>
                        </h4>
                        <p class="text-muted mb-0">Conexiones utilizadas</p>
                    </div>
                    <div class="col-md-3">
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width:@(((double)Model.CurrentSubscription.UsedConnections / Model.CurrentSubscription.MaxConnections) * 100)%">
                            </div>
                        </div>
                        <small class="text-muted">Uso de conexiones</small>
                    </div>
                    <div class="col-md-3 text-end">
                        @{
                            var avail = Model.CurrentSubscription.MaxConnections - Model.CurrentSubscription.UsedConnections;
                        }
                        <h5 class="mb-0 text-success">@avail</h5>
                        <p class="text-muted mb-0">Disponibles</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        @* Usuarios conectados *@
        <div class="col-md-8 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-user-check me-2"></i> Usuarios Conectados
                </div>
                <div class="card-body">
                    @if (Model.CurrentSubscription.ConnectedUsers.Any())
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Usuario</th>
                                    <th>Nombre</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.CurrentSubscription.ConnectedUsers)
                                {
                                    <tr>
                                        <td><strong>#@u.Id</strong></td>
                                        <td><strong>@u.UserName</strong></td>
                                        <td>
                                            @(string.IsNullOrEmpty(u.Name)
                                                                                ? "<span class=\"text-muted\">No especificado</span>"
                                                                                : u.Name)
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="fas fa-check me-1"></i> Conectado
                                    </span>
                                </td>
                                <td>
                                    <form method="post" action="@Url.Action("RemoveConnection","Plans")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="childUserId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Seguro que deseas remover este usuario?');">
                                            <i class="fas fa-user-times me-1"></i> Remover
                                        </button>
                                    </form>
                                </td>
                            </tr>
                                                        }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-user-slash fa-3x mb-3"></i>
                            <div>No hay usuarios conectados</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Agregar conexión *@
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <i class="fas fa-user-plus me-2"></i> Agregar Usuario por ID
                </div>
                <div class="card-body">
                    @{
                        var canAdd = Model.CurrentSubscription.UsedConnections < Model.CurrentSubscription.MaxConnections;
                    }
                    @if (canAdd)
                    {
                        <form method="post" action="@Url.Action("AddConnection","Plans")">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="childUserId" class="form-label">ID del Usuario</label>
                                <input type="number" id="childUserId" name="childUserId" class="form-control"
                                       placeholder="Ejemplo: 123" required min="1" />
                                <div class="form-text">Ingresa el ID numérico del usuario a agregar</div>
                            </div>
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-plus me-2"></i> Agregar Usuario
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                            <p>Límite de conexiones alcanzado</p>
                            <a href="@Url.Action("Change", "Plans")" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-arrow-up me-1"></i> Actualizar Plan
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-warning text-dark">
                    <i class="fas fa-lightbulb me-2"></i> Consejos
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li><i class="fas fa-check text-success me-2"></i>Acceso inmediato</li>
                        <li><i class="fas fa-user-times text-primary me-2"></i>Remoción en cualquier momento</li>
                        <li><i class="fas fa-users text-info me-2"></i>Biblioteca personal independiente</li>
                        <li><i class="fas fa-hashtag text-warning me-2"></i>Solo necesitas el ID del usuario</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* FAQ *@
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <i class="fas fa-question-circle me-2"></i> Preguntas Frecuentes
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6><i class="fas fa-user-friends text-primary me-2"></i>¿Cómo funcionan las conexiones?</h6>
                    <p class="text-muted">Compartes acceso a tu plan manteniendo perfiles independientes.</p>
                    <h6><i class="fas fa-hashtag text-success me-2"></i>¿Dónde encuentro el ID?</h6>
                    <p class="text-muted">El usuario puede encontrar su ID en su perfil o configuración.</p>
                </div>
                <div class="col-md-6">
                    <h6><i class="fas fa-times-circle text-danger me-2"></i>¿Qué pasa al remover?</h6>
                    <p class="text-muted">El usuario pierde acceso pero conserva su biblioteca personal.</p>
                    <h6><i class="fas fa-chart-line text-warning me-2"></i>¿Se ve la actividad?</h6>
                    <p class="text-muted">Solo se ve quién está conectado, no la actividad detallada.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <a href="@Url.Action("Index", "Plans")" class="btn btn-secondary me-2">
            <i class="fas fa-arrow-left me-1"></i> Volver a Planes
        </a>
        <a href="@Url.Action("Change", "Plans")" class="btn btn-outline-primary">
            <i class="fas fa-exchange-alt me-1"></i> Cambiar Plan
        </a>
    </div>
</div>

<style>
    @@media (max-width: 768px) {
        .table-responsive

    {
        font-size: 0.9rem;
    }

    .connection-status {
        text-align: left;
        margin-bottom: 1rem;
    }

    }
</style>