@model dynamic
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Two-Factor Authentication Settings";
    bool is2FAEnabled = ViewBag.Is2FAEnabled ?? false;
    int recoveryCodesLeft = ViewBag.RecoveryCodesLeft ?? 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-shield-alt"></i> Ajustes de 2FA</h4>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border-0 bg-light mb-3">
                                <div class="card-body text-center">
                                    <i class="fas fa-mobile-alt fa-3x text-primary mb-3"></i>
                                    <h5>Autenticación en dos pasos</h5>
                                    <p class="text-muted">Agrega una capa extra de seguridad.</p>
                                    <span class="badge bg-@(is2FAEnabled ? "success" : "secondary") fs-6">
                                        <i class="fas fa-@(is2FAEnabled ? "check" : "times")"></i>
                                        @(is2FAEnabled ? "Habilitado" : "Deshabilitado")
                                    </span>
                                    <div class="mt-3">
                                        @if (is2FAEnabled)
                                        {
                                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#disable2FAModal">
                                                <i class="fas fa-times"></i> Deshabilitar 2FA
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#enable2FAModal">
                                                <i class="fas fa-shield-alt"></i> Habilitar 2FA
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (is2FAEnabled)
                        {
                            <div class="col-md-6">
                                <div class="card border-0 bg-light mb-3">
                                    <div class="card-body text-center">
                                        <i class="fas fa-key fa-3x text-warning mb-3"></i>
                                        <h5>Códigos de recuperación</h5>
                                        <p class="text-muted">Puedes usarlos si pierdes tu dispositivo.</p>
                                        <span class="badge bg-info fs-6">
                                            <i class="fas fa-info-circle"></i>
                                            @recoveryCodesLeft códigos restantes
                                        </span>
                                        <div class="mt-3">
                                            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#generateCodesModal">
                                                <i class="fas fa-sync"></i> Generar nuevos
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modales omitidos para brevedad: #enable2FAModal, #disable2FAModal, #generateCodesModal como antes -->
@section Scripts {
    <script>
        document.getElementById('generateCodesBtn').addEventListener('click', () => {
            const pwd = document.getElementById('generatePassword').value;
            if (!pwd) { alert('Ingresa tu contraseña'); return; }

            fetch('@Url.Action("GenerateRecoveryCodes", "VAuth")', {
                method: 'POST',
                headers: {'Content-Type':'application/json'},
                body: JSON.stringify(pwd)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    const list = document.getElementById('recoveryCodesList');
                    list.innerHTML = '';
                    data.recoveryCodes.forEach(c => {
                        const d = document.createElement('div');
                        d.className = 'mb-1 font-monospace';
                        d.textContent = c;
                        list.appendChild(d);
                    });
                    document.getElementById('newRecoveryCodes').style.display = 'block';
                    document.getElementById('generateCodesBtn').style.display = 'none';
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(() => alert('Error al generar los códigos'));
        });
    </script>
}
