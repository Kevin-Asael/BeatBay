@model BeatBay.DTOs.CreateSongDto

@{
    ViewData["Title"] = "Upload Song";
}

<style>
    /* Asegurar que el body tenga el gradiente completo */
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    /* Contenedor principal que ocupa toda la pantalla excepto el navbar */
    .upload-container {
        min-height: calc(100vh - 80px);
        background: transparent;
        padding: 2rem 1rem;
        margin: 0;
        position: relative;
        width: 100%;
    }

    /* Contenido sin card, directamente sobre el fondo */
    .upload-content {
        background: transparent;
        border-radius: 0;
        box-shadow: none;
        border: none;
        transition: none;
        max-width: 600px;
        margin: 0 auto;
    }

    /* Icono principal */
    .upload-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
        margin: 0 auto;
        transition: all 0.3s ease;
    }

        .upload-icon:hover {
            transform: scale(1.05);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.4);
        }

    /* Títulos */
    .upload-title {
        font-weight: 700;
        color: white;
        font-size: 2rem;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }

    .upload-subtitle {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.1rem;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    /* Labels personalizados */
    .form-label-custom {
        font-weight: 600;
        color: white;
        margin-bottom: 0.75rem;
        display: block;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: center;
    }

    /* Controles de formulario - MÁS GRANDES Y CENTRADOS */
    .form-control-custom {
        border-radius: 20px;
        padding: 1.5rem 2rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        font-size: 1.2rem;
        color: white;
        text-align: center;
        width: 100%;
        height: 60px;
        display: block;
        margin: 0 auto;
    }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.7);
            text-align: center;
        }

        .form-control-custom:focus {
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 0 0.3rem rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.15);
            outline: none;
            color: white;
            transform: scale(1.02);
        }

        .form-control-custom:hover {
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.01);
        }

    /* Input de duración (readonly) */
    .duration-input {
        background: rgba(255, 255, 255, 0.05) !important;
        color: rgba(255, 255, 255, 0.8) !important;
    }

    /* Contenedor de inputs más espacioso */
    .input-container {
        margin-bottom: 2rem;
        text-align: center;
    }

    /* Floating labels adaptados para inputs más grandes */
    .form-floating {
        position: relative;
        margin-bottom: 0;
    }

        .form-floating > label {
            color: rgba(255, 255, 255, 0.7);
            padding: 1.75rem 2rem 0.5rem;
            font-size: 1rem;
            text-align: center;
            width: 100%;
        }

        .form-floating > .form-control-custom:focus ~ label,
        .form-floating > .form-control-custom:not(:placeholder-shown) ~ label {
            color: rgba(255, 255, 255, 0.9);
            transform: scale(0.85) translateY(-1rem) translateX(0);
            font-weight: 600;
        }

    /* Input de archivo también más grande y centrado */
    .file-input-custom {
        border-radius: 20px;
        padding: 1.5rem 2rem;
        border: 2px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
        font-size: 1.1rem;
        color: white;
        width: 100%;
        height: 60px;
        display: block;
        margin: 0 auto;
        text-align: center;
    }

        .file-input-custom:hover {
            border-color: rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.01);
        }

        .file-input-custom:focus {
            border-color: rgba(255, 255, 255, 0.4);
            box-shadow: 0 0 0 0.3rem rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.15);
            outline: none;
            transform: scale(1.02);
        }

    /* Botones personalizados */
    .btn-custom {
        border-radius: 15px;
        font-weight: 600;
        padding: 1rem 2rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        font-size: 1.1rem;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #5856eb, #7c3aed);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
            color: white;
        }

    .btn-light-custom {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
    }

        .btn-light-custom:hover {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* Información de archivo */
    .file-upload-info {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.9rem;
        text-align: center;
        margin-top: 1rem;
    }

    .file-info-text {
        color: #10b981;
        background: rgba(16, 185, 129, 0.2);
        padding: 0.75rem;
        border-radius: 12px;
        border-left: 3px solid #10b981;
        backdrop-filter: blur(5px);
        text-align: center;
        margin-top: 1rem;
    }

    /* Alertas personalizadas */
    .custom-alert {
        border-radius: 15px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        backdrop-filter: blur(10px);
        margin-bottom: 2rem;
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.2);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fecaca;
    }

    .custom-alert i {
        margin-right: 15px;
        font-size: 1.3rem;
    }

    /* Wrapper para upload de archivos */
    .file-upload-wrapper {
        position: relative;
        text-align: center;
    }

    /* Responsividad */
    @@media (max-width: 768px) {
        .upload-container

    {
        padding: 1rem 0.5rem;
        min-height: calc(100vh - 70px);
    }

    .upload-content {
        margin: 0 0.5rem;
        max-width: 100%;
    }

    .upload-title {
        font-size: 1.75rem;
    }

    .upload-icon {
        width: 70px;
        height: 70px;
        font-size: 1.75rem;
    }

    .form-control-custom,
    .file-input-custom {
        font-size: 1.1rem;
        padding: 1.25rem 1.5rem;
        height: 55px;
    }

    }

    /* Validación de errores */
    .text-danger {
        color: #ef4444 !important;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        text-align: center;
        display: block;
    }

    /* Asegurar que no haya márgenes en el contenedor principal */
    .container-fluid {
        padding: 0 !important;
        margin: 0 !important;
    }

    /* Resetear cualquier margen del row */
    .row {
        margin: 0 !important;
    }
</style>

<div class="upload-container">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="upload-content p-4 p-md-5">
                <div class="text-center mb-5">
                    <div class="upload-icon-container mb-4">
                        <div class="upload-icon">
                            <i class="fas fa-music"></i>
                        </div>
                    </div>
                    <h2 class="upload-title mb-3">Upload New Song</h2>
                    <p class="upload-subtitle">Share your music with the BeatBay community</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="custom-alert alert-danger">
                        <div class="alert-content">
                            <i class="fas fa-exclamation-circle"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    </div>
                }

                <form asp-action="Create" enctype="multipart/form-data" method="post">
                    <div class="input-container">
                        <div class="form-floating">
                            <input asp-for="Title" class="form-control-custom" placeholder="Song title" />
                        </div>
                    </div>

                    <div class="input-container">
                        <div class="form-floating">
                            <input asp-for="Duration" class="form-control-custom duration-input" id="durationInput" type="text" placeholder="Duration" readonly />
                        </div>
                        <span asp-validation-for="Duration" class="text-danger small"></span>
                    </div>

                    <div class="input-container">
                        <div class="form-floating">
                            <input asp-for="Genre" class="form-control-custom" placeholder="Musical genre" />
                        </div>
                    </div>

                    <div class="input-container">
                        <label for="audioFile" class="form-label-custom">Audio File</label>
                        <div class="file-upload-wrapper">
                            <input type="file" name="audioFile" id="audioFile" class="file-input-custom" accept=".mp3,.wav,.flac,.m4a" required />
                            <div class="file-upload-info">Accepted formats: .mp3, .wav, .flac, .m4a</div>
                        </div>
                        <div id="audioInfo" class="file-info-text" style="display: none;">
                            <i class="fas fa-info-circle me-1"></i>
                            <span id="fileDetails"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-3 d-md-flex justify-content-md-center mt-5">
                        <a asp-action="Index" class="btn-custom btn-light-custom me-md-3">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn-custom btn-primary-custom">
                            <i class="fas fa-upload me-2"></i>Upload Song
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('audioFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            // Show file information
            document.getElementById('fileDetails').textContent = `Selected file: ${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
            document.getElementById('audioInfo').style.display = 'block';

            // Create audio object to get duration
            const audio = document.createElement('audio');
            audio.preload = 'metadata';

            audio.onloadedmetadata = function() {
                window.URL.revokeObjectURL(audio.src);
                const duration = audio.duration;
                const minutes = Math.floor(duration / 60);
                const seconds = Math.floor(duration % 60);
                const formattedDuration = `${minutes}:${seconds.toString().padStart(2, '0')}`;

                // Format for time input (HH:MM:SS)
                const hours = Math.floor(minutes / 60);
                const remainingMinutes = minutes % 60;
                const timeFormatted = `${hours.toString().padStart(2, '0')}:${remainingMinutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                document.getElementById('durationInput').value = timeFormatted;
            };

            audio.src = URL.createObjectURL(file);
        });
    </script>
}